# AI API 설정 (선택사항 - 없으면 규칙 기반 추천 사용)
VITE_AI_API_KEY=
VITE_AI_API_URL=

# 지도 API 설정 (선택사항 - 없으면 외부 링크 사용)
VITE_MAP_API_KEY=
VITE_MAP_API_TYPE=kakao

# 카카오 로컬 API / 네이버 검색 API 키는 더 이상 프론트에서 관리하지 않습니다.
# ildan-nawa-backend의 .env에서 KAKAO_REST_API_KEY / NAVER_CLIENT_ID / NAVER_CLIENT_SECRET로 설정하세요.
# 프론트는 /api/kakao/local/keyword, /api/naver/blog 백엔드 프록시를 호출합니다.

# 카카오 JavaScript 키 (카카오톡 공유 SDK용 - 도메인 제한된 공개 키라 프론트에 둬도 안전)
VITE_KAKAO_JS_KEY=

# 앱 설정
VITE_APP_CITY=ulsan
VITE_APP_ENV=development
